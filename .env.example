# Token from @BotFather
BOT_TOKEN=123456:replace-with-botfather-token

# The public HTTPS URL of your Mini App = your tunnel subdomain.
# Must match the Cloudflare public hostname and the BotFather Mini App URL.
PUBLIC_URL=https://quiz.your-domain.com

# Where the SQLite DB lives inside the container (mapped to the quizdata volume).
QUIZ_DB_PATH=/data/quiz.db

# Connector token from the Cloudflare Zero Trust dashboard
# (Networks -> Tunnels -> your tunnel -> the long string after `--token`).
CLOUDFLARE_TUNNEL_TOKEN=eyJ...replace-with-tunnel-token

# Telegram numeric user id allowed to run /reports (0 = disabled)
ADMIN_ID=0

# --- Gemini art generation (scripts/gen_art.py) ---
# Image models (gemini-*-image, imagen-*) need BILLING enabled on the GCP project;
# the free tier has 0 image quota. Text models work on the free tier.
GEMINI_API_KEY=
GEMINI_PROJECT=projects/xxxxxxxxxxxx
